  "item": [
    {
      "name": "Azure Setup (Graph)",
      "description": "Asignación de App Roles al service principal vía Microsoft Graph (Client Credentials). Ejecutar UNA sola vez, en orden:\n1. Get Graph Token\n2. Get Service Principal ID\n3. Assign Role ADMIN (y/o Assign Role DESCARGA)\n\nRequiere que la app tenga los permisos Graph `Application.Read.All` y `AppRoleAssignment.ReadWrite.All` con admin consent. No usa usuario: se autentica la app con su client secret.",
      "item": [
        {
          "name": "1. Get Graph Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Token obtenido y guardado en graphToken', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.access_token).to.be.a('string').and.not.empty;",
                  "    pm.collectionVariables.set('graphToken', json.access_token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                },
                {
                  "key": "client_id",
                  "value": "{{clientId}}"
                },
                {
                  "key": "client_secret",
                  "value": "{{clientSecret}}"
                },
                {
                  "key": "scope",
                  "value": "{{graphScope}}"
                }
              ]
            },
            "url": {
              "raw": "{{tokenUrl}}",
              "host": [
                "{{tokenUrl}}"
              ]
            },
            "description": "Obtiene un token para Microsoft Graph (scope `.default`). Guarda el token en la variable `graphToken`."
          },
          "response": []
        },
        {
          "name": "2. Get Service Principal ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('spId obtenido y guardado', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.id).to.be.a('string').and.not.empty;",
                  "    pm.collectionVariables.set('spId', json.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{graphToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://graph.microsoft.com/v1.0/servicePrincipals(appId='{{clientId}}')",
              "protocol": "https",
              "host": [
                "graph",
                "microsoft",
                "com"
              ],
              "path": [
                "v1.0",
                "servicePrincipals(appId='{{clientId}}')"
              ]
            },
            "description": "Obtiene el service principal de la app por su appId y guarda su `id` en la variable `spId`."
          },
          "response": []
        },
        {
          "name": "3. Assign Role ADMIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{graphToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"principalId\": \"{{spId}}\",\n  \"resourceId\": \"{{spId}}\",\n  \"appRoleId\": \"{{appRoleIdAdmin}}\"\n}"
            },
            "url": {
              "raw": "https://graph.microsoft.com/v1.0/servicePrincipals/{{spId}}/appRoleAssignedTo",
              "protocol": "https",
              "host": [
                "graph",
                "microsoft",
                "com"
              ],
              "path": [
                "v1.0",
                "servicePrincipals",
                "{{spId}}",
                "appRoleAssignedTo"
              ]
            },
            "description": "Asigna el App Role ADMIN al propio service principal. El próximo token de la API incluirá `roles: [\"ADMIN\"]`."
          },
          "response": []
        },
        {
          "name": "3b. Assign Role DESCARGA (opcional)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{graphToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"principalId\": \"{{spId}}\",\n  \"resourceId\": \"{{spId}}\",\n  \"appRoleId\": \"{{appRoleIdDescarga}}\"\n}"
            },
            "url": {
              "raw": "https://graph.microsoft.com/v1.0/servicePrincipals/{{spId}}/appRoleAssignedTo",
              "protocol": "https",
              "host": [
                "graph",
                "microsoft",
                "com"
              ],
              "path": [
                "v1.0",
                "servicePrincipals",
                "{{spId}}",
                "appRoleAssignedTo"
              ]
            },
            "description": "Opcional. Asigna también el App Role DESCARGA al mismo service principal. Útil solo si quieres que esta app tenga ambos roles; para demostrar permisos separados conviene una segunda app registration."
          },
          "response": []
        },
        {
          "name": "4. Asignar Rol ADMIN a usuario admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{graphToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"principalId\": \"{{adminUserId}}\",\n  \"resourceId\": \"{{spId}}\",\n  \"appRoleId\": \"{{appRoleIdAdmin}}\"\n}"
            },
            "url": {
              "raw": "https://graph.microsoft.com/v1.0/servicePrincipals/{{spId}}/appRoleAssignedTo",
              "protocol": "https",
              "host": [
                "graph",
                "microsoft",
                "com"
              ],
              "path": [
                "v1.0",
                "servicePrincipals",
                "{{spId}}",
                "appRoleAssignedTo"
              ]
            },
            "description": "Asigna el App Role ADMIN al USUARIO admin (`principalId` = `adminUserId`). Requisito previo: el App Role ADMIN debe permitir `allowedMemberTypes: [\"User\"]` y la variable `adminUserId` debe contener el Object ID del usuario (Azure portal > Users > admin > Object ID). El token de ese usuario incluirá `roles: [\"ADMIN\"]`."
          },
          "response": []
        },
        {
          "name": "5. Asignar Rol DESCARGA a usuario descarga",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{graphToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"principalId\": \"{{descargaUserId}}\",\n  \"resourceId\": \"{{spId}}\",\n  \"appRoleId\": \"{{appRoleIdDescarga}}\"\n}"
            },
            "url": {
              "raw": "https://graph.microsoft.com/v1.0/servicePrincipals/{{spId}}/appRoleAssignedTo",
              "protocol": "https",
              "host": [
                "graph",
                "microsoft",
                "com"
              ],
              "path": [
                "v1.0",
                "servicePrincipals",
                "{{spId}}",
                "appRoleAssignedTo"
              ]
            },
            "description": "Asigna el App Role DESCARGA al USUARIO descarga (`principalId` = `descargaUserId`). Requisito previo: el App Role DESCARGA debe permitir `allowedMemberTypes: [\"User\"]` y la variable `descargaUserId` debe contener el Object ID del usuario. El token de ese usuario incluirá `roles: [\"DESCARGA\"]` (solo podrá usar el endpoint de descarga)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Guides",
      "item": [
        {
          "name": "Create Guide",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response has id, guideNumber, efsPath and s3Key', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.id).to.be.a('string').and.not.empty;",
                  "    pm.expect(json.guideNumber).to.match(/^GD-\\d{4}-\\d{6}$/);",
                  "    pm.expect(json.status).to.eql('UPLOADED_TO_S3');",
                  "    pm.expect(json.efsPath).to.be.a('string').and.not.empty;",
                  "    pm.expect(json.s3Key).to.be.a('string').and.not.empty;",
                  "    pm.collectionVariables.set('guideId', json.id);",
                  "    pm.collectionVariables.set('carrierName', json.carrierName);",
                  "    pm.collectionVariables.set('dispatchDate', json.dispatchDate);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"carrierName\": \"Transportes Rápidos\",\n  \"recipientName\": \"María González\",\n  \"originAddress\": \"Av. Providencia 1234, Santiago\",\n  \"destinationAddress\": \"Calle Huérfanos 567, Santiago\",\n  \"description\": \"Electrónicos\",\n  \"dispatchDate\": \"2026-06-02\",\n  \"ownerEmail\": \"responsable@empresa.cl\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/guides",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "guides"
              ]
            },
            "description": "Crea una guía de despacho. Genera PDF en EFS, sube a S3, `guideNumber`, `efsPath`, `s3Key` y `status: UPLOADED_TO_S3`."
          },
          "response": []
        },
        {
          "name": "Download Guide PDF",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Content-Type is application/pdf', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/pdf');",
                  "});",
                  "",
                  "pm.test('Response body is not empty', function () {",
                  "    pm.expect(pm.response.stream.length).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/guides/{{guideId}}/download",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "guides",
                "{{guideId}}",
                "download"
              ]
            },
            "description": "Descarga el PDF desde S3 (fallback EFS). Ejecutar después de Create Guide."
          },
          "response": []
        },
        {
          "name": "Get Guide by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response matches guideId', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.id).to.eql(pm.collectionVariables.get('guideId'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/guides/{{guideId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "guides",
                "{{guideId}}"
              ]
            },
            "description": "Obtiene una guía por ID. Devuelve 404 si no existe o fue eliminada lógicamente."
          },
          "response": []
        },
        {
          "name": "List Guides",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is an array', function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/guides",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "guides"
              ]
            },
            "description": "Lista todas las guías activas (excluye las marcadas como DELETED)."
          },
          "response": []
        },
        {
          "name": "Search Guides",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is an array', function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/guides/search?carrierName={{carrierName}}&date={{dispatchDate}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "guides",
                "search"
              ],
              "query": [
                {
                  "key": "carrierName",
                  "value": "{{carrierName}}",
                  "description": "Nombre exacto del transportista"
                },
                {
                  "key": "date",
                  "value": "{{dispatchDate}}",
                  "description": "Fecha de despacho (ISO-8601, ej. 2026-06-02)"
                }
              ]
            },
            "description": "Busca guías por transportista y fecha exacta de despacho."
          },
          "response": []
        },
        {
          "name": "Update Guide",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Status is UPLOADED_TO_S3', function () {",
                  "    pm.expect(pm.response.json().status).to.eql('UPLOADED_TO_S3');",
                  "});",
                  "",
                  "pm.test('efsPath and s3Key are present', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.efsPath).to.be.a('string').and.not.empty;",
                  "    pm.expect(json.s3Key).to.be.a('string').and.not.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
